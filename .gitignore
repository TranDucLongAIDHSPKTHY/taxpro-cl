__pycache__/
*.py[cod]
.pytest_cache/
.vscode/
log/*
!log/.gitkeep
results/*
!results/.gitkeep

# Audit-trail deliverables: small, hand-curated
# CSVs mapping runs/claims to evidence -- kept despite the results/* rule
# above, unlike the large per-run result dumps that rule is meant to exclude.
!results/results_manifest.csv
!results/metrics_seed.csv
!results/claim_evidence.csv
!results/README.md
# Small analysis outputs (bootstrap CIs, NDCG companions, Wilcoxon tables, figure)
# that claim_evidence.csv and the paper's Online Resource 1 cite as sources;
# results/README.md lists each file and the script that writes it.
!results/*.json
!results/*.tex
!results/Fig3.pdf
!results/statistical_tests_*.csv
# Per-user differences behind the sign-flip p-values of Online Resource 1, Table S26.
!results/a2_multiplicity_peruser_diffs.npz
# Pre-registered confirmatory evaluation (docs/confirmatory_protocol.md):
# screening outputs, the frozen selection file and, later, sealed-test results.
!results/confirmatory/
# ... except superseded outputs that no table cites.
results/q9_ab_main_vs_v3_nomerge.json
results/a2_factorial_bootstrap_all.json
results/a2_multiplicity_correction.json
results/a2_multiplicity_correction_100k.json
results/a2_multiplicity_correction_100k_seed123_check.json
results/a3_leaf_size_stats.json
results/a3_prototype_distance_by_leaf_size.json
results/a4_view_cosine_by_degree.json
results/same_leaf_weight_bootstrap.json
results/statistical_tests_A2.csv
prototypes/*
!prototypes/.gitkeep
figures/*
!figures/.gitkeep
preprocessing_logs/*
!preprocessing_logs/.gitkeep
*.tmp

# Generated inference/analysis output from tools/ranking;
# regenerated by running the pipeline, not source.
tools/ranking/result/

# Downloaded raw data and metadata; regenerated from the bootstrap pipeline.
# taxonomy_variants/ is kept: it is small (~230MB total), required input for
# TaxPro-CL (item-to-leaf assignments), and not re-derivable without the raw
# metadata below -- so it travels with a clone instead of needing a manual copy.
/dataset/
/dataset_raw/
/metadata/*
!/metadata/taxonomy_variants/
# merge summaries (~0.4 KB each) back Online Resource 1, Section S28 and Table S28.
!/metadata/merge_summary_*.json

# Virtual environments created following the README.
.venv/
venv/
